# Copy to .env and fill in what you want enabled.
# With nothing set, the mock collector runs and the scene animates offline.
# NEVER put real secrets in this file — it is committed.

# --- Canonical ingest: POST /api/events (always on)
# When INGEST_TOKEN is set, requests must send `Authorization: Bearer <token>`.
# When it is unset, only loopback (127.0.0.1/::1) requests are accepted and a
# loud warning is printed at boot. Set a token to ingest from other hosts or
# from inside Docker (host requests are not loopback in a container).
# INGEST_TOKEN=

# --- Cursor Cloud Agents API (https://cursor.com/docs/cloud-agent/api/endpoints)
# Create a key at Cursor Dashboard -> API Keys. Enables the cursor-cloud collector.
# CURSOR_API_KEY=

# --- Cursor CLI collector: spawns `agent --print --output-format stream-json`.
# CURSOR_CLI=1
# Prompt given to the spawned CLI agent:
# CURSOR_CLI_PROMPT=Summarize this repository

# --- Generic webhook collector (claude / chatgtm / anything): POST /hooks/:sourceId
# WEBHOOKS=1
# Optional shared secret; when set, requests must send X-Daycare-Secret header.
# WEBHOOK_SECRET=

# --- Force the mock collector on/off. Default: on unless a real source is configured.
# MOCK=1

# --- Persistence (atomic JSON snapshot of the latest agent state).
# On by default; set PERSIST=0 to disable. DATA_DIR/STATE_FILE choose the path.
# PERSIST=0
# DATA_DIR=./data
# STATE_FILE=state.json

# --- Network binding. HOST defaults to 127.0.0.1 (local-only dashboard). The
# Docker image sets HOST=0.0.0.0 and the compose file binds the host port to
# loopback instead. PORT wins over the legacy BUS_PORT; default 8787.
# HOST=127.0.0.1
# PORT=8787
# BUS_PORT=8787

# --- Used by `npm run emit` to reach the hub (defaults to http://127.0.0.1:8787).
# DAYCARE_URL=http://127.0.0.1:8787
