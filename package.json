{
  "name": "agent-day-care",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n bus,vite -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/main.mjs --banner:js=\"import{createRequire as _cr}from'module';const require=_cr(import.meta.url);\"",
    "start": "tsx server/main.ts",
    "emit": "tsx scripts/emit.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "phaser": "^3.87.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
